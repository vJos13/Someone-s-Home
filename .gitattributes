# Normalizar finales de línea
* text=auto

# Código y texto
*.cs        text diff=csharp eol=lf
*.shader    text eol=lf
*.hlsl      text eol=lf
*.md        text eol=lf

# Archivos YAML de Unity: texto, pero se fusionan con UnityYAMLMerge (ver README)
*.unity       text eol=lf merge=unityyamlmerge
*.prefab      text eol=lf merge=unityyamlmerge
*.asset       text eol=lf merge=unityyamlmerge
*.mat         text eol=lf merge=unityyamlmerge
*.anim        text eol=lf merge=unityyamlmerge
*.controller  text eol=lf merge=unityyamlmerge
*.playable    text eol=lf merge=unityyamlmerge
*.meta        text eol=lf
*.shadergraph    text eol=lf
*.shadersubgraph text eol=lf

# Binarios (no intentar hacer diff/merge)
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.exr  binary
*.hdr  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
